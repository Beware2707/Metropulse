# Copy to .env and fill in real values. All variables are read by metropulse.config.Settings.

# --- External services -------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://metropulse:metropulse@localhost:5432/metropulse
REDIS_URL=redis://localhost:6379/0

# --- Delhi Open Transit Data -------------------------------------------------
DMRC_API_KEY=your-api-key-here
GTFS_RT_VEHICLE_POSITIONS_URL=https://otd.delhi.gov.in/api/realtime/VehiclePositions.pb
# Off by default -- the URL above is Delhi's citywide bus GPS feed, not a
# verified Delhi Metro train feed (checked against the real feed: vehicle
# IDs are road registration plates, ~4,000 simultaneous vehicles, positions
# spread across ordinary roads). With this off, the worker estimates train
# positions from the static schedule instead (honestly labelled
# "schedule_estimate" everywhere, never shown as live GPS). Only set this to
# true once you have a feed confirmed to actually be Delhi Metro rolling
# stock, and update the URL above to point at it.
GTFS_RT_ENABLED=false

# Optional background job: periodically checks DMRC's static GTFS feed
# (https://otd.delhi.gov.in/data/staticDMRC/) for updates and auto-loads a
# new one when found (see application/gtfs_static_updater.py). Off by
# default -- the endpoint only accepts a POST with a CSRF cookie/token pair,
# satisfied today by a documented but unofficial workaround (see
# infrastructure/gtfs_static/dmrc_client.py) that could break if DMRC
# changes their site, so this needs an explicit opt-in. The data changes
# rarely (unchanged since 2023-08-10 as of writing), hence the long default
# interval. A newly-loaded dataset is never silently patched -- see
# data/raw_gtfs/OVERRIDE_NOTES.md for why calendar end_dates specifically
# need a human decision, not automation.
# GTFS_STATIC_URL=https://otd.delhi.gov.in/data/staticDMRC/
# GTFS_STATIC_AUTO_UPDATE_ENABLED=true
# GTFS_STATIC_CHECK_INTERVAL_SECONDS=86400

# --- Realtime engine ---------------------------------------------------------
POLL_INTERVAL_SECONDS=5
HTTP_TIMEOUT_SECONDS=10
FETCH_MAX_ATTEMPTS=3
STALE_AFTER_SECONDS=90
HISTORY_RETENTION_HOURS=72

# --- Route resolution / ETA --------------------------------------------------
STATION_RADIUS_M=75
DEFAULT_SPEED_MPS=9.0
MIN_SPEED_MPS=2.0
MAX_SPEED_MPS=25.0
DWELL_TIME_SECONDS=25

# Optional: JSON list of regex rewrite rules applied to realtime IDs before
# looking them up in the static GTFS tables, e.g.
# ID_MAPPING_RULES=[{"field":"trip_id","pattern":"^RT_","replacement":""}]
ID_MAPPING_RULES=[]
# Optional: path to a JSON file {"trip_id": {"rt-id": "static-id"}, "route_id": {...}}
# ID_MAPPING_FILE=/app/config/id_mapping.json

# --- WebSocket ---------------------------------------------------------------
WS_HEARTBEAT_SECONDS=20
WS_REPLAY_BUFFER_SIZE=512

# --- Commuter features ---------------------------------------------------------
# Empty disables all /api/v1/admin/* endpoints.
ADMIN_API_KEY=
TIMEZONE=Asia/Kolkata
# Commuter rules (destination alerts, journeys) are event-driven off feed
# polls; only clock-based reminders run on this interval.
REMINDER_EVAL_INTERVAL_SECONDS=60
JOURNEY_MAX_AGE_HOURS=6
ANALYTICS_RETENTION_DAYS=90
ANALYTICS_MAX_BATCH=500
DEFAULT_COACH_COUNT=8
CROWD_LOOKBACK_DAYS=28
CROWD_HOUR_WINDOW=1

# Metro Intelligence: commute prediction and delay estimation lookback windows.
COMMUTE_PREDICTION_LOOKBACK_DAYS=90
DELAY_PREDICTION_LOOKBACK_DAYS=60

# Metro Intelligence: proactive "time to leave" nudges (worker-side).
PROACTIVE_COMMUTE_EVAL_INTERVAL_SECONDS=300
PROACTIVE_COMMUTE_LEAD_MINUTES=15
PROACTIVE_COMMUTE_MIN_CONFIDENCE=0.5

# Commute Replay: rolling window summed into the "This Month" card.
COMMUTE_REPLAY_WINDOW_DAYS=30

# Metro Intelligence: optional LLM-assisted delay-estimate refinement.
# Leave every key below empty to keep this feature completely inert --
# delay estimates use only the plain historical statistic, exactly as if
# this section didn't exist. Set any subset of the three provider keys to
# activate the periodic worker job that refines predictions for busy
# routes; see application/intelligence/llm_delay_refiner.py. Configured
# providers are tried in priority order -- Claude, then OpenAI, then
# Gemini -- with automatic fallover to the next one on failure (see
# infrastructure/llm_fallback.py). You don't need all three; one is enough.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest
LLM_DELAY_REFINEMENT_EVAL_INTERVAL_SECONDS=1800
LLM_DELAY_REFINEMENT_MIN_SAMPLE_SIZE=10
LLM_DELAY_REFINEMENT_MAX_BUCKETS_PER_CYCLE=20
LLM_DELAY_REFINEMENT_MAX_AGE_SECONDS=3600
LLM_DELAY_REFINEMENT_MAX_ADJUSTMENT_FRACTION=0.5

# --- Ops ---------------------------------------------------------------------
# Per-replica HTTP rate limit (token bucket per client IP). 0 disables.
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_BURST=100

LOG_LEVEL=INFO
# text (development) or json (production log aggregation)
LOG_FORMAT=text
