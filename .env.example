# Copy to .env and fill in real values. All variables are read by metropulse.config.Settings.

# --- External services -------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://metropulse:metropulse@localhost:5432/metropulse
REDIS_URL=redis://localhost:6379/0

# --- Delhi Open Transit Data -------------------------------------------------
DMRC_API_KEY=your-api-key-here
GTFS_RT_VEHICLE_POSITIONS_URL=https://otd.delhi.gov.in/api/realtime/VehiclePositions.pb

# --- Realtime engine ---------------------------------------------------------
POLL_INTERVAL_SECONDS=5
HTTP_TIMEOUT_SECONDS=10
FETCH_MAX_ATTEMPTS=3
STALE_AFTER_SECONDS=90
HISTORY_RETENTION_HOURS=72

# --- Route resolution / ETA --------------------------------------------------
STATION_RADIUS_M=75
DEFAULT_SPEED_MPS=9.0
MIN_SPEED_MPS=2.0
MAX_SPEED_MPS=25.0
DWELL_TIME_SECONDS=25

# Optional: JSON list of regex rewrite rules applied to realtime IDs before
# looking them up in the static GTFS tables, e.g.
# ID_MAPPING_RULES=[{"field":"trip_id","pattern":"^RT_","replacement":""}]
ID_MAPPING_RULES=[]
# Optional: path to a JSON file {"trip_id": {"rt-id": "static-id"}, "route_id": {...}}
# ID_MAPPING_FILE=/app/config/id_mapping.json

# --- WebSocket ---------------------------------------------------------------
WS_HEARTBEAT_SECONDS=20
WS_REPLAY_BUFFER_SIZE=512

# --- Commuter features ---------------------------------------------------------
# Empty disables all /api/v1/admin/* endpoints.
ADMIN_API_KEY=
TIMEZONE=Asia/Kolkata
ALERT_EVAL_INTERVAL_SECONDS=5
REMINDER_EVAL_INTERVAL_SECONDS=60
JOURNEY_MAX_AGE_HOURS=6
ANALYTICS_RETENTION_DAYS=90
ANALYTICS_MAX_BATCH=500
DEFAULT_COACH_COUNT=8
CROWD_LOOKBACK_DAYS=28
CROWD_HOUR_WINDOW=1

LOG_LEVEL=INFO
